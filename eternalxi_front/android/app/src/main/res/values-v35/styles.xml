<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+: evita edge-to-edge forzado en UCrop para que la toolbar no quede bajo el status bar. -->
    <style name="Theme.EternalXi.UCrop" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/ucrop_toolbar</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="actionBarSize">72dp</item>
        <item name="android:actionBarSize">72dp</item>
    </style>
</resources>
