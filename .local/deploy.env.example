# Copia a deploy.env y rellena los valores reales.
# deploy.env NO se sube a Git.

DEPLOY_SSH_HOST=
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=root
DEPLOY_SSH_PASSWORD=

DEPLOY_REMOTE_DIR=/opt/miapi
DEPLOY_REMOTE_JAR=eternalxi-api-0.0.1-SNAPSHOT.jar
DEPLOY_SYSTEMD_SERVICE=miapi

DEPLOY_BACKEND_DIR=eternalxi_api_back
DEPLOY_JAR_NAME=eternalxi-api-0.0.1-SNAPSHOT.jar

FLUTTER_DEVICE_ID=
FLUTTER_PROJECT_DIR=eternalxi_front

